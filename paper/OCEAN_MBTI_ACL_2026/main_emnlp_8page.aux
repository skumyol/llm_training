\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Study overview and evaluation stack. A scenario bank and world context are used to generate multi-turn dialogue with 29-field social-state labels, which are validated and split into train, validation, and test sets. The same data supports four experimental tracks: from-scratch SLMs, OCEAN/VAD conditioning encoders, response-generation models, and the structured Qwen3-4B social-state pipeline. Track D is the main contribution.}}{9}{figure.caption.22}\protected@file@percent }
\newlabel{fig:architecture_stack}{{7}{9}{Study overview and evaluation stack. A scenario bank and world context are used to generate multi-turn dialogue with 29-field social-state labels, which are validated and split into train, validation, and test sets. The same data supports four experimental tracks: from-scratch SLMs, OCEAN/VAD conditioning encoders, response-generation models, and the structured Qwen3-4B social-state pipeline. Track D is the main contribution}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Alternative pipeline diagram showing the structured-state architecture. This figure presents the same three-stage pipeline (latent predictor, fast/slow router, response generator) with an alternative visual layout to the main Figure~\ref {fig:pipeline}.}}{10}{figure.caption.23}\protected@file@percent }
\newlabel{fig:pipeline_alt}{{8}{10}{Alternative pipeline diagram showing the structured-state architecture. This figure presents the same three-stage pipeline (latent predictor, fast/slow router, response generator) with an alternative visual layout to the main Figure~\ref {fig:pipeline}}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Data flow from scenario specifications to validated splits and paper artifacts. Each generated turn is validated against the $Z_t$ schema before use in training or evaluation.}}{10}{figure.caption.24}\protected@file@percent }
\newlabel{fig:data_flow}{{9}{10}{Data flow from scenario specifications to validated splits and paper artifacts. Each generated turn is validated against the $Z_t$ schema before use in training or evaluation}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces ConditionalDialogue soft-prefix response model. The response model projects an 8D OCEAN+VAD vector into soft-prefix tokens before LoRA response generation; placebo ablations show that the prefix mechanism helps, while the semantic content of OCEAN/VAD values explains little of the gain.}}{10}{figure.caption.25}\protected@file@percent }
\newlabel{fig:best_model}{{10}{10}{ConditionalDialogue soft-prefix response model. The response model projects an 8D OCEAN+VAD vector into soft-prefix tokens before LoRA response generation; placebo ablations show that the prefix mechanism helps, while the semantic content of OCEAN/VAD values explains little of the gain}{figure.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Scenario-type distribution across train/val/test splits (episode-stratified 80/10/10).}}{10}{table.caption.29}\protected@file@percent }
\newlabel{tab:scenario_dist}{{13}{10}{Scenario-type distribution across train/val/test splits (episode-stratified 80/10/10)}{table.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces From-scratch small-LM baseline (Track A): validation perplexity over 3 seeds (mean $\pm $ std). GPT-22M (22.3M) beats MoE (22.4M) by 4.0\% at equal parameter count, reversing the parameter-confounded comparison.}}{10}{figure.caption.26}\protected@file@percent }
\newlabel{fig:slm_ppl}{{11}{10}{From-scratch small-LM baseline (Track A): validation perplexity over 3 seeds (mean $\pm $ std). GPT-22M (22.3M) beats MoE (22.4M) by 4.0\% at equal parameter count, reversing the parameter-confounded comparison}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Response-generation baselines (Track C): validation perplexity. Gemma-2-2B-it is the primary Gemma baseline; Gemma-4-E2B reruns (3 epochs) show zero gain from gold $Z_t$ XML prefix conditioning (13.48 vs. 13.61).}}{10}{figure.caption.27}\protected@file@percent }
\newlabel{fig:response_ppl}{{12}{10}{Response-generation baselines (Track C): validation perplexity. Gemma-2-2B-it is the primary Gemma baseline; Gemma-4-E2B reruns (3 epochs) show zero gain from gold $Z_t$ XML prefix conditioning (13.48 vs. 13.61)}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Qwen3-4B latent-predictor training dynamics. Mean accuracy keeps improving through epoch 4, while response-policy macro-F1 peaks earlier, indicating a possible trade-off between broad head accuracy and decision-policy calibration.}}{10}{figure.caption.28}\protected@file@percent }
\newlabel{fig:qwen_training}{{13}{10}{Qwen3-4B latent-predictor training dynamics. Mean accuracy keeps improving through epoch 4, while response-policy macro-F1 peaks earlier, indicating a possible trade-off between broad head accuracy and decision-policy calibration}{figure.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Memory requirements per model. Training memory includes gradients and AdamW optimizer states; inference memory is weights only plus KV-cache at batch size 1. ``CPU'' means the model can run without a GPU.}}{10}{table.caption.30}\protected@file@percent }
\newlabel{tab:hardware}{{14}{10}{Memory requirements per model. Training memory includes gradients and AdamW optimizer states; inference memory is weights only plus KV-cache at batch size 1. ``CPU'' means the model can run without a GPU}{table.caption.30}{}}
