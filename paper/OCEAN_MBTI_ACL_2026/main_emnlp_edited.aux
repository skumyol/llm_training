\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Study overview and evaluation stack. A scenario bank and world context are used to generate multi-turn dialogue with 29-field social-state labels, which are validated and split into train, validation, and test sets. The same data supports four experimental tracks: from-scratch SLMs, OCEAN/VAD conditioning encoders, response-generation models, and the structured Qwen3-4B social-state pipeline. Track D is the main contribution.}}{13}{figure.caption.33}\protected@file@percent }
\newlabel{fig:architecture_stack}{{3}{13}{Study overview and evaluation stack. A scenario bank and world context are used to generate multi-turn dialogue with 29-field social-state labels, which are validated and split into train, validation, and test sets. The same data supports four experimental tracks: from-scratch SLMs, OCEAN/VAD conditioning encoders, response-generation models, and the structured Qwen3-4B social-state pipeline. Track D is the main contribution}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Alternative pipeline diagram showing the inspectable-bottleneck architecture. This figure presents the same three-stage pipeline (latent predictor, fast/slow router, response generator) with an alternative visual layout to the main Figure~\ref {fig:pipeline}.}}{13}{figure.caption.34}\protected@file@percent }
\newlabel{fig:pipeline_alt}{{4}{13}{Alternative pipeline diagram showing the inspectable-bottleneck architecture. This figure presents the same three-stage pipeline (latent predictor, fast/slow router, response generator) with an alternative visual layout to the main Figure~\ref {fig:pipeline}}{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Data flow from scenario specifications to validated splits and paper artifacts. Each generated turn is validated against the $Z_t$ schema before use in training or evaluation.}}{13}{figure.caption.35}\protected@file@percent }
\newlabel{fig:data_flow}{{5}{13}{Data flow from scenario specifications to validated splits and paper artifacts. Each generated turn is validated against the $Z_t$ schema before use in training or evaluation}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces ConditionalDialogue soft-prefix response model. The response model projects an 8D OCEAN+VAD vector into soft-prefix tokens before LoRA response generation; placebo ablations show that the prefix mechanism helps, while the semantic content of OCEAN/VAD values explains little of the gain.}}{13}{figure.caption.36}\protected@file@percent }
\newlabel{fig:best_model}{{6}{13}{ConditionalDialogue soft-prefix response model. The response model projects an 8D OCEAN+VAD vector into soft-prefix tokens before LoRA response generation; placebo ablations show that the prefix mechanism helps, while the semantic content of OCEAN/VAD values explains little of the gain}{figure.caption.36}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Scenario-type distribution across train/val/test splits (episode-stratified 80/10/10).}}{13}{table.caption.40}\protected@file@percent }
\newlabel{tab:scenario_dist}{{9}{13}{Scenario-type distribution across train/val/test splits (episode-stratified 80/10/10)}{table.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces From-scratch small-LM baseline (Track A): validation perplexity over 3 seeds (mean $\pm $ std). GPT-22M (22.3M) beats MoE (22.4M) by 4.0\% at equal parameter count, reversing the parameter-confounded comparison.}}{14}{figure.caption.37}\protected@file@percent }
\newlabel{fig:slm_ppl}{{7}{14}{From-scratch small-LM baseline (Track A): validation perplexity over 3 seeds (mean $\pm $ std). GPT-22M (22.3M) beats MoE (22.4M) by 4.0\% at equal parameter count, reversing the parameter-confounded comparison}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Response-generation baselines (Track C): validation perplexity. Gemma-2-2B-it is the primary Gemma baseline; Gemma-4-E2B reruns (3 epochs) show zero gain from gold $Z_t$ XML prefix conditioning (13.48 vs. 13.61).}}{14}{figure.caption.38}\protected@file@percent }
\newlabel{fig:response_ppl}{{8}{14}{Response-generation baselines (Track C): validation perplexity. Gemma-2-2B-it is the primary Gemma baseline; Gemma-4-E2B reruns (3 epochs) show zero gain from gold $Z_t$ XML prefix conditioning (13.48 vs. 13.61)}{figure.caption.38}{}}
