\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Alternative pipeline diagram showing the inspectable-bottleneck architecture. This figure presents the same three-stage pipeline (latent predictor, fast/slow router, response generator) with an alternative visual layout to the main Figure~\ref {fig:pipeline}.}}{19}{figure.caption.61}\protected@file@percent }
\newlabel{fig:pipeline_alt}{{11}{19}{Alternative pipeline diagram showing the inspectable-bottleneck architecture. This figure presents the same three-stage pipeline (latent predictor, fast/slow router, response generator) with an alternative visual layout to the main Figure~\ref {fig:pipeline}}{figure.caption.61}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Data flow from scenario specifications to validated splits and paper artifacts. Each generated turn is validated against the $Z_t$ schema before use in training or evaluation.}}{19}{figure.caption.62}\protected@file@percent }
\newlabel{fig:data_flow}{{12}{19}{Data flow from scenario specifications to validated splits and paper artifacts. Each generated turn is validated against the $Z_t$ schema before use in training or evaluation}{figure.caption.62}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces ConditionalDialogue soft-prefix response model. The response model projects an 8D OCEAN+VAD vector into soft-prefix tokens before LoRA response generation; placebo ablations show that the prefix mechanism helps, while the semantic content of OCEAN/VAD values explains little of the gain.}}{19}{figure.caption.63}\protected@file@percent }
\newlabel{fig:best_model}{{13}{19}{ConditionalDialogue soft-prefix response model. The response model projects an 8D OCEAN+VAD vector into soft-prefix tokens before LoRA response generation; placebo ablations show that the prefix mechanism helps, while the semantic content of OCEAN/VAD values explains little of the gain}{figure.caption.63}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces From-scratch small-LM baseline (Track A): validation perplexity over 3 seeds (mean $\pm $ std). GPT-22M (22.3M) beats MoE (22.4M) by 4.0\% at equal parameter count, reversing the parameter-confounded comparison.}}{19}{figure.caption.64}\protected@file@percent }
\newlabel{fig:slm_ppl}{{14}{19}{From-scratch small-LM baseline (Track A): validation perplexity over 3 seeds (mean $\pm $ std). GPT-22M (22.3M) beats MoE (22.4M) by 4.0\% at equal parameter count, reversing the parameter-confounded comparison}{figure.caption.64}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Response-generation baselines (Track C): validation perplexity. Gemma-2-2B-it is the primary Gemma baseline; Gemma-4-E2B reruns (3 epochs) show zero gain from gold $Z_t$ XML prefix conditioning (13.48 vs. 13.61).}}{20}{figure.caption.65}\protected@file@percent }
\newlabel{fig:response_ppl}{{15}{20}{Response-generation baselines (Track C): validation perplexity. Gemma-2-2B-it is the primary Gemma baseline; Gemma-4-E2B reruns (3 epochs) show zero gain from gold $Z_t$ XML prefix conditioning (13.48 vs. 13.61)}{figure.caption.65}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Qwen3-4B latent-predictor training dynamics. Mean accuracy keeps improving through epoch 4, while response-policy macro-F1 peaks earlier, indicating a possible trade-off between broad head accuracy and decision-policy calibration.}}{20}{figure.caption.66}\protected@file@percent }
\newlabel{fig:qwen_training}{{16}{20}{Qwen3-4B latent-predictor training dynamics. Mean accuracy keeps improving through epoch 4, while response-policy macro-F1 peaks earlier, indicating a possible trade-off between broad head accuracy and decision-policy calibration}{figure.caption.66}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Scenario-type distribution across train/val/test splits (episode-stratified 80/10/10).}}{20}{table.caption.67}\protected@file@percent }
\newlabel{tab:scenario_dist}{{17}{20}{Scenario-type distribution across train/val/test splits (episode-stratified 80/10/10)}{table.caption.67}{}}
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Memory requirements per model. Training memory includes gradients and AdamW optimizer states; inference memory is weights only plus KV-cache at batch size 1. ``CPU'' means the model can run without a GPU.}}{20}{table.caption.68}\protected@file@percent }
\newlabel{tab:hardware}{{18}{20}{Memory requirements per model. Training memory includes gradients and AdamW optimizer states; inference memory is weights only plus KV-cache at batch size 1. ``CPU'' means the model can run without a GPU}{table.caption.68}{}}
