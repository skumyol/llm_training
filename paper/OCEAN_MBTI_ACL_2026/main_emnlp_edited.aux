\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Benchmark stack. Track A trains from-scratch small LMs for offline NPC dialogue; Track B trains OCEAN/VAD encoders; Track C trains response generators; Track D is the structured Qwen3 social-state pipeline. The same scenario-generated data feeds all synthetic dialogue tracks.}}{11}{figure.caption.32}\protected@file@percent }
\newlabel{fig:architecture_stack}{{3}{11}{Benchmark stack. Track A trains from-scratch small LMs for offline NPC dialogue; Track B trains OCEAN/VAD encoders; Track C trains response generators; Track D is the structured Qwen3 social-state pipeline. The same scenario-generated data feeds all synthetic dialogue tracks}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Data flow from scenario specifications to validated splits and paper artifacts. Each generated turn is validated against the $Z_t$ schema before use in training or evaluation.}}{12}{figure.caption.33}\protected@file@percent }
\newlabel{fig:data_flow}{{4}{12}{Data flow from scenario specifications to validated splits and paper artifacts. Each generated turn is validated against the $Z_t$ schema before use in training or evaluation}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces ConditionalDialogue soft-prefix response model. The response model projects an 8D OCEAN+VAD vector into soft-prefix tokens before LoRA response generation; placebo ablations show that the prefix mechanism helps, while the semantic content of OCEAN/VAD values explains little of the gain.}}{12}{figure.caption.34}\protected@file@percent }
\newlabel{fig:best_model}{{5}{12}{ConditionalDialogue soft-prefix response model. The response model projects an 8D OCEAN+VAD vector into soft-prefix tokens before LoRA response generation; placebo ablations show that the prefix mechanism helps, while the semantic content of OCEAN/VAD values explains little of the gain}{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces From-scratch small-LM baseline (Track A): validation perplexity over 3 seeds (mean $\pm $ std). GPT-22M (22.3M) beats MoE (22.4M) by 4.0\% at equal parameter count, reversing the parameter-confounded comparison.}}{12}{figure.caption.35}\protected@file@percent }
\newlabel{fig:slm_ppl}{{6}{12}{From-scratch small-LM baseline (Track A): validation perplexity over 3 seeds (mean $\pm $ std). GPT-22M (22.3M) beats MoE (22.4M) by 4.0\% at equal parameter count, reversing the parameter-confounded comparison}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Response-generation baselines (Track C): validation perplexity. Gemma-2-2B-it is the primary Gemma baseline; Gemma-4-E2B reruns (3 epochs) show zero gain from gold $Z_t$ XML prefix conditioning (13.48 vs. 13.61).}}{12}{figure.caption.36}\protected@file@percent }
\newlabel{fig:response_ppl}{{7}{12}{Response-generation baselines (Track C): validation perplexity. Gemma-2-2B-it is the primary Gemma baseline; Gemma-4-E2B reruns (3 epochs) show zero gain from gold $Z_t$ XML prefix conditioning (13.48 vs. 13.61)}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Qwen3-4B latent-predictor training dynamics. Mean accuracy keeps improving through epoch 4, while response-policy macro-F1 peaks earlier, indicating a possible trade-off between broad head accuracy and decision-policy calibration.}}{12}{figure.caption.37}\protected@file@percent }
\newlabel{fig:qwen_training}{{8}{12}{Qwen3-4B latent-predictor training dynamics. Mean accuracy keeps improving through epoch 4, while response-policy macro-F1 peaks earlier, indicating a possible trade-off between broad head accuracy and decision-policy calibration}{figure.caption.37}{}}
