\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Inspectable-bottleneck pipeline for NPC dialogue generation. A LoRA-adapted Qwen3-4B latent predictor maps raw dialogue context and NPC profile information to a structured predicted social state $\hat  {Z}_t$. The predicted state exposes six groups of variables before generation and is used by a deterministic fast/slow router. Low-risk turns use direct response generation, while high-risk turns condition the response generator on $\hat  {Z}_t$ and disclosure constraints.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{5}{Inspectable-bottleneck pipeline for NPC dialogue generation. A LoRA-adapted Qwen3-4B latent predictor maps raw dialogue context and NPC profile information to a structured predicted social state $\hat {Z}_t$. The predicted state exposes six groups of variables before generation and is used by a deterministic fast/slow router. Low-risk turns use direct response generation, while high-risk turns condition the response generator on $\hat {Z}_t$ and disclosure constraints}{figure.caption.5}{}}
